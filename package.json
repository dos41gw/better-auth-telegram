{
  "name": "better-auth-telegram",
  "version": "4.0.1",
  "type": "module",
  "description": "Telegram authentication plugin for Better Auth",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepublishOnly": "bun run type-check && bun run test && bun run build"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "telegram",
    "telegram-login",
    "telegram-mini-apps",
    "authentication",
    "oauth",
    "plugin",
    "typescript"
  ],
  "author": "Vibe Code <hello@vcode.sh> (https://vcode.sh)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dos41gw/better-auth-telegram.git"
  },
  "bugs": {
    "url": "https://github.com/dos41gw/better-auth-telegram/issues"
  },
  "homepage": "https://github.com/dos41gw/better-auth-telegram#readme",
  "peerDependencies": {
    "better-auth": ">=1.7.0 <1.8.0",
    "@better-auth/core": ">=1.7.0 <1.8.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.6",
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "better-auth": "1.7.6",
    "happy-dom": "20.14.5",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
